[Unit]
Description=Company24 NER masking service (Natasha) - 152-FZ PII minimization for ai-rop
After=network.target

[Service]
Type=simple
User=nerservice
Group=nerservice
WorkingDirectory=/opt/ner-service
ExecStart=/opt/ner-service/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8801
Restart=on-failure
RestartSec=3
# Сервис слушает ТОЛЬКО 127.0.0.1 — наружу порт 8801 не публикуется (см. README).
# Никаких секретов/сети наружу сервису не нужно.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
